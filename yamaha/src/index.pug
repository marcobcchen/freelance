- let webTitle = "好加在城市 | YAMAHA台灣山葉機車"

doctype html
html(lang="zh-tw")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(property="og:site_name", content=`${webTitle}`)
    meta(property="og:url", content="https://www.yamahacity.com.tw")
    meta(property="og:type", content="website")
    meta(property="og:title", content=`${webTitle}`)
    meta(property="og:description", content="歡迎來到好加在城市，一起陪媽媽創造美好回憶，參加YAMAHA母親節活動，就有機會讓媽媽把JOG騎回家！")
