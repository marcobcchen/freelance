    header 
      a.logo(href="https://www.yamaha-motor.com.tw/", target="_blank", onclick="trackEvent('header', 'logo');")
        img(src="images/logo.png", alt="Yamaha")
      a.menu(href="#")
      nav 
        a.title(href="campaign2/", onclick="trackEvent('menu', '父親節活動'); onead_pixel_track_campaign();")
