            img(src="images/nav_icon_7.png", alt="")
          .text 
            .text-sub Campaign
            .text-main 父親節寫信募集活動
        .navigate
          a(href="showroom/", onclick="trackEvent('menu', '經銷商');")
            .pic 
              img(src="images/nav_icon_1.png", alt="")
            .text 
              .text-sub YAMAHA YSP
              .text-main 車款介紹
          a(href="cinema/", onclick="trackEvent('menu', '電影院');")
            .pic 
              img(src="images/nav_icon_2.png", alt="")
            .text 
              .text-sub Cinema
              .text-main 我的家庭好加在
          a(href="#", data-popup="good_home", onclick="trackEvent('menu', '郝家');")
            .pic 
              img(src="images/nav_icon_3.png", alt="")
            .text 
              .text-sub 郝家
              .text-main 郝家人物簡介
          a(href="#", data-popup="stadium", onclick="trackEvent('menu', '足球場');")
            .pic 
              img(src="images/nav_icon_4.png", alt="")
            .text 
              .text-sub Football field
              .text-main 全家出去玩
          a(href="#", data-popup="mall", onclick="trackEvent('menu', '購物中心');")
            .pic 
              img(src="images/nav_icon_5.png", alt="")
            .text 
              .text-sub Mall
              .text-main 去血拼吧
          a(href="#", data-popup="school", onclick="trackEvent('menu', '學校');")
            .pic 
              img(src="images/nav_icon_6.png", alt="")
            .text 
              .text-sub School
              .text-main 開心上學去
