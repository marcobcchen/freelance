    title=webTitle
    link(rel="shortcut icon", sizes="16x16", href="images/favicon.ico")
    link(rel="apple-touch-icon", sizes="1024x1024", href="images/apple-touch-icon.png")
    link(type="text/css", rel="stylesheet", href="css/index.css")
    script(src="https://adlogs.ad2iction.com/tracker/event/trackeventv4.js?dn=.yamahacity.com.tw")
    script. 
      //- ad2 tracking code
      trackAdEvent('yamahacityA202205landing','yamahacityA202205','yamahacityA202205landing');
